{
  "compilerOptions": {
    // 支持 import a from '@/a'
    "baseUrl": ".",
    "paths": {
      "@/*": ["src/*"],
      // "components/*": ["src/components/*"],
    },
    // 解决 tsx 文件无法识别 redux 的问题
    // "types": ["node", "react-redux"],
    "target": "es5",
    "lib": [
      "dom",
      "dom.iterable",
      "esnext"
    ],
    "allowJs": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "strict": true,
    "forceConsistentCasingInFileNames": true,
    "noFallthroughCasesInSwitch": true,
    "module": "esnext",
    "moduleResolution": "node",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "jsx": "react-jsx"
  },
  "include": [
    "src"
  ]
}
